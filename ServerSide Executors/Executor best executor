--// Functions
local musicSound = Instance.new("Sound")
musicSound.SoundId = "rbxassetid://72089843969979"
musicSound.Volume = 2.5
musicSound.PlaybackSpeed = 0.21
musicSound.Looped = true
musicSound.Parent = workspace

openButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
	openButton.Text = mainFrame.Visible and "Close" or "Open"
end)

titleBtn.MouseButton1Click:Connect(function()
	billboard.Parent = player.Character:WaitForChild("Head")
end)

armsBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end
	local right = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
	local left = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
	if right then right.CFrame = right.CFrame * CFrame.Angles(0, math.rad(45), 0) end
	if left then left.CFrame = left.CFrame * CFrame.Angles(0, math.rad(-45), 0) end
end)

floatBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end
	local hrp = char:WaitForChild("HumanoidRootPart")

	local pad = Instance.new("Part")
	pad.Size = Vector3.new(5, 1, 5)
	pad.Color = Color3.fromRGB(128, 0, 255)
	pad.Anchored = false
	pad.CanCollide = true
	pad.Position = hrp.Position - Vector3.new(0, 3, 0)
	pad.Parent = workspace

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = pad
	weld.Part1 = hrp
	weld.Parent = pad

	-- Float effect
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Velocity = Vector3.new(0, 10, 0)
	bodyVelocity.MaxForce = Vector3.new(0, 1000, 0)
	bodyVelocity.Parent = pad

	game:GetService("Debris"):AddItem(pad, 10)
end)

musicBtn.MouseButton1Click:Connect(function()
	if not musicSound.IsPlaying then
		musicSound:Play()
	else
		musicSound:Stop()
	end
end)
