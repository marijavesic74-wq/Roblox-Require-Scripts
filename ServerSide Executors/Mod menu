-- Bloxy Cola: give a consumable that heals + temp jump boost
local function giveBloxyCola()
    local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack")
    local tool = Instance.new("Tool")
    tool.Name = "Bloxy Cola"
    tool.RequiresHandle = true
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1,1,1)
    handle.CanCollide = false
    handle.Parent = tool
    tool.Parent = backpack
    tool.Activated:Connect(function()
        refreshCharRefs()
        if hum then
            hum.Health = math.min(hum.MaxHealth, (hum.Health or 0) + 30)
            local orig = hum.JumpPower
            if orig then
                hum.JumpPower = math.min(200, orig + 30)
                delay(6, function() if hum then hum.JumpPower = orig end end)
            end
        end
        tool:Destroy()
    end)
end
buttons["BloxyCola"].MouseButton1Click:Connect(function() giveBloxyCola() end)

