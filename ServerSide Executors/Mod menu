-- Spin (set AssemblyAngularVelocity) - client visual
local spinEnabled = false
local spinConn
buttons["Spin"].MouseButton1Click:Connect(function()
    spinEnabled = not spinEnabled
    buttons["Spin"].Text = spinEnabled and "Spin to 99 ✅" or "Spin to 99"
    refreshCharRefs()
    if spinEnabled and root then
        root.AssemblyAngularVelocity = Vector3.new(0,99,0)
        if spinConn then spinConn:Disconnect() spinConn = nil end
        spinConn = RunService.Heartbeat:Connect(function()
            if root and spinEnabled then
                root.AssemblyAngularVelocity = Vector3.new(0,99,0)
            end
        end)
    else
        if spinConn then spinConn:Disconnect() spinConn = nil end
        if root then
            root.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end
    end
end)

-- AutoFling (local): when your root touches someone, local upward push to you (visual)
local autoFling = false
local function enableAutoFlingOnChar(c)
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
    if not r then return end
    r.Touched:Connect(function(part)
        if autoFling then
            local other = part:FindFirstAncestorOfClass("Model")
            if other and other ~= c and other:FindFirstChildOfClass("Humanoid") then
                -- push local player up (visual only)
                refreshCharRefs()
                if root then
                    root.AssemblyLinearVelocity = Vector3.new(0,120,0)
                end
            end
        end
    end)
end
player.CharacterAdded:Connect(function(c)
    wait(0.2)
    if autoFling then enableAutoFlingOnChar(c) end
end)

buttons["AutoFling"].MouseButton1Click:Connect(function()
    autoFling = not autoFling
    buttons["AutoFling"].Text = autoFling and "Auto fling ✅" or "Auto fling"
    if autoFling and player.Character then
        enableAutoFlingOnChar(player.Character)
    end
end)

