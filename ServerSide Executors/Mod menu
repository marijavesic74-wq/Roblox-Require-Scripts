-- track character/humanoid/root
local char, hum, root
local function refreshCharRefs()
    char = player.Character
    if char then
        hum = char:FindFirstChildOfClass("Humanoid")
        root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    else
        hum = nil
        root = nil
    end
end
refreshCharRefs()
player.CharacterAdded:Connect(function(c)
    char = c
    wait(0.1)
    refreshCharRefs()
end)
player.CharacterRemoving:Connect(function() char, hum, root = nil, nil, nil end)

