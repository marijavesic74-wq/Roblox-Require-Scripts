task.spawn(function()
	while true do
		local taco = Instance.new("Part")
		taco.Size = Vector3.new(2, 0.5, 2)
		taco.Position = Vector3.new(math.random(-100, 100), 100, math.random(-100, 100))
		taco.BrickColor = BrickColor.new("Bright orange")
		taco.Name = "Taco"
		taco.Anchored = false
		taco.Parent = workspace
		task.wait(0.3)
	end
end)

